@page "/study/quiz"
@inject ISrsService Srs
@inject ICharacterRepository Repo

<PageTitle>Quiz — Jappo</PageTitle>

<div class="page-study">
    @if (!_started)
    {
        <div class="study-setup">
            <h1>Multiple-Choice Quiz</h1>
            <p class="setup-desc">See a character and pick the correct reading from four options.</p>
            <DeckSelector @bind-SelectedSets="_selectedSets" />
            <button class="btn-primary" @onclick="StartSession" disabled="@(_selectedSets.Count == 0)">
                Start Quiz
            </button>
        </div>
    }
    else if (_done)
    {
        <div class="study-done">
            <div class="done-icon">@ScoreEmoji</div>
            <h2>Quiz Complete!</h2>
            <p>Score: @_correct / @_queue.Count (@ScorePercent%)</p>
            <div class="done-actions">
                <button class="btn-primary" @onclick="Restart">Try Again</button>
                <a class="btn-secondary" href="">Back Home</a>
            </div>
        </div>
    }
    else if (_currentChar is not null)
    {
        <ProgressBar Current="_index" Total="_queue.Count" />

        <div class="quiz-question">
            <div class="quiz-glyph">@_currentChar.Glyph</div>
            <div class="quiz-prompt">What is the reading of this character?</div>
        </div>

        <ChoiceGrid Options="_options"
                    CorrectId="@(_currentChar.Id)"
                    ShowReadings="@(_currentChar.Set != CharacterSet.Kanji)"
                    OnAnswer="OnAnswer" />

    }
</div>

@code {
    private List<CharacterSet> _selectedSets = [CharacterSet.Hiragana];
    private List<Character> _queue = [];
    private List<Character> _options = [];
    private int _index;
    private int _correct;
    private bool _started;
    private bool _done;
    private Random _rng = new();

    private Character? _currentChar => _index < _queue.Count ? _queue[_index] : null;

    private int ScorePercent => _queue.Count == 0 ? 0 : _correct * 100 / _queue.Count;
    private string ScoreEmoji => ScorePercent >= 90 ? "🏆" : ScorePercent >= 70 ? "👍" : "📚";

    private void StartSession()
    {
        var pool = _selectedSets.SelectMany(s => Repo.GetBySet(s)).ToList();
        _queue = pool.OrderBy(_ => _rng.Next()).Take(20).ToList();
        _index = 0;
        _correct = 0;
        _started = true;
        _done = false;
        BuildOptions();
    }

    private void BuildOptions()
    {
        if (_currentChar is null) return;

        var pool = _selectedSets.SelectMany(s => Repo.GetBySet(s))
            .Where(c => c.Id != _currentChar.Id)
            .OrderBy(_ => _rng.Next())
            .Take(3)
            .ToList();

        pool.Add(_currentChar);
        _options = pool.OrderBy(_ => _rng.Next()).ToList();
    }

    private async Task OnAnswer(bool correct)
    {
        if (correct) _correct++;

        var card = await Srs.GetOrCreateCardAsync(_currentChar!.Id);
        await Srs.ApplyReviewAsync(card, correct ? SrsQuality.Good : SrsQuality.Blackout);

        StateHasChanged();
        await Task.Delay(800);

        _index++;
        if (_index >= _queue.Count) _done = true;
        else BuildOptions();
    }

    private void Restart()
    {
        _started = false;
        _done = false;
        _index = 0;
        _correct = 0;
        _queue.Clear();
    }
}
